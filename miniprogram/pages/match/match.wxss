/* 匹配页专属样式 */
.start-wrap {
  padding: 160rpx 20rpx 0;
}

.start-title {
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 16rpx;
}

.status-bar {
  background: #1A1A1A;
  border-radius: 20rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 24rpx;
}

.status-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.status-bar .mini {
  color: #A8A8A2;
  margin-top: 6rpx;
}

/* 层级卡片 */
.layer-card {
  background: #FFFFFF;
  border: 1rpx solid #EDEDEA;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.layer-card.miss {
  opacity: 1;
  background: #FAFAF8;
}

.layer-card.hit {
  opacity: 1;
  border-color: #FF6B35;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.12);
}

.layer-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.layer-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #1A1A1A;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 16rpx;
}

.layer-card.hit .layer-badge {
  background: #FF6B35;
}

.layer-name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.layer-state {
  font-size: 24rpx;
  color: #9A9A94;
}

.layer-card.hit .layer-state {
  color: #FF6B35;
  font-weight: 600;
}

.layer-desc {
  font-size: 26rpx;
  color: #6B6B6B;
  line-height: 1.7;
}

/* 匹配到的人 */
.match-box {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #EDEDEA;
}

.match-user {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFF1EA;
  color: #FF6B35;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  line-height: 88rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.match-info {
  flex: 1;
}

.match-name {
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
