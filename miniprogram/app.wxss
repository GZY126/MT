/* app.wxss —— 全局样式，配色与网页端保持一致 */
page {
  background: #F7F7F5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1A1A1A;
  font-size: 28rpx;
  line-height: 1.65;
}

.page-wrap {
  padding: 24rpx 28rpx 60rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border: 1rpx solid #EDEDEA;
  border-radius: 20rpx;
  padding: 30rpx 30rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: #FF6B35;
  margin-right: 14rpx;
}

/* ---------- 资产条 ---------- */
.asset-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.asset-item {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #EDEDEA;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
}

.asset-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B35;
  line-height: 1.2;
}

.asset-label {
  font-size: 22rpx;
  color: #9A9A94;
  margin-top: 6rpx;
}

/* ---------- 技能标签 ---------- */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 22rpx;
}

.tag-row:last-child {
  margin-bottom: 0;
}

.tag-label {
  font-size: 24rpx;
  color: #9A9A94;
  width: 130rpx;
  line-height: 52rpx;
}

.tag {
  font-size: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 100rpx;
  margin: 0 14rpx 14rpx 0;
  line-height: 1.5;
}

.tag-teach {
  background: #FFF1EA;
  color: #FF6B35;
  border: 1rpx solid #FFD9C7;
}

.tag-learn {
  background: #EEF2FF;
  color: #4B5EE4;
  border: 1rpx solid #D9DFFB;
}

/* ---------- 按钮 ---------- */
.btn {
  display: block;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
}

.btn-primary {
  background: #1A1A1A;
  color: #FFFFFF;
}

.btn-primary::after {
  border: none;
}

.btn-orange {
  background: #FF6B35;
  color: #FFFFFF;
}

.btn-orange::after {
  border: none;
}

.btn-ghost {
  background: #FFFFFF;
  color: #1A1A1A;
  border: 1rpx solid #EDEDEA;
}

.btn-ghost::after {
  border: none;
}

/* ---------- 通用文本 ---------- */
.tip {
  font-size: 23rpx;
  color: #9A9A94;
  line-height: 1.7;
}

.mini {
  font-size: 22rpx;
  color: #9A9A94;
}

.bold {
  font-weight: 600;
}

.hl {
  color: #FF6B35;
}
